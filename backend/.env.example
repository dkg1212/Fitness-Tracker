MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=ironcore
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
# CLERK_AUTHORIZED_PARTIES — comma-separated list of frontend origins whose JWTs
# this backend will accept.  Set this explicitly in production to your Vercel URL.
# Falls back to CORS_ORIGINS if not set (convenient for local dev, too broad for prod).
CLERK_AUTHORIZED_PARTIES=https://your-app.vercel.app
APP_TZ=UTC
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
